# Server Configuration
PORT=8080
RUST_LOG=info

# Supabase PostgreSQL
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres?sslmode=require

# Real-Debrid API
# Get your API key from: https://real-debrid.com/apitoken
RD_API_KEY=your_real_debrid_api_key_here

# RuTracker Session Cookie (optional - only needed for RuTracker scraping)
# Login to RuTracker, open DevTools > Application > Cookies, copy the 'bb_session' cookie value
RUTRACKER_COOKIE=your_rutracker_session_cookie_here

# Scraping Configuration
CACHE_TTL_HOURS=24
MAX_CONCURRENT_SCRAPERS=5
REQUEST_TIMEOUT_SECONDS=10

# Torrent Filtering
MIN_SEEDERS=1  # Minimum seeders required (1 = filter dead torrents, 10 = quality filter)

# Base URL for absolute links (required for Stremio Web)
BASE_URL=http://torrentio-stack-aleinto97-54335f00.koyeb.app

# Optional: Proxy configuration for blocked sites
# PROXY_URL=http://user:pass@proxy:8080

# Stremio Addon Metadata
ADDON_NAME="Hydrogen Torrents"
ADDON_DESCRIPTION="High-performance torrent scraper addon for Stremio"
ADDON_ID=ai.hydrogen.stremio
ADDON_VERSION=0.1.0